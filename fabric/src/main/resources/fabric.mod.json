{
  "schemaVersion": 1,
  "id": "${mod_id}",
  "version": "${mod_version}",
  "name": "${mod_name}",
  "description": "Rust-style respawning: right-click beds to add them to a list, then choose which one to respawn on.",
  "license": "${mod_license}",
  "environment": "*",
  "entrypoints": {
    "main": [
      "net.amro.multiplebedspawnpoints.MultipleBedSpawnpointsFabric"
    ]
  },
  "mixins": [
    "multiplebedspawnpoints.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=${fabric_loader_version}",
    "minecraft": "~${minecraft_version}",
    "java": ">=21",
    "fabric-api": "*"
  }
}
